# Python bytecode files (CANNOT be prevented from being created - this is normal Python behavior)
__pycache__/
*.py[cod]
*$py.class
*.so

# Excel files with _new suffix (fallback files from when original is open)
*_new.xlsx

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Excel temporary files (created by Excel when file is open)
~$*.xlsx
~$*.xls

# Test output files
_test_*.xlsx

# OS files
.DS_Store
Thumbs.db

# Environment / credentials — never commit these
.env
*.env

# Entity output files (large, regenerated on each run)
output/upload_templates/
output/*_actual_data.json
output/entities/
output/project_data.db
node_modules